  "extraction": {
    "date": {
      "months": {
        "january": "01", "feb": "02", "february": "02", "mar": "03", "march": "03",
        "apr": "04", "april": "04", "may": "05", "jun": "06", "june": "06",
        "jul": "07", "july": "07", "aug": "08", "august": "08", "sep": "09",
        "sept": "09", "september": "09", "oct": "10", "october": "10",
        "nov": "11", "november": "11", "dec": "12", "december": "12"
      },
      "pattern": "(january|february|march|april|may|june|july|august|september|october|november|december|jan|feb|mar|apr|jun|jul|aug|sep|sept|oct|nov|dec)\\s+(\\d{1,2}),?\\s+(\\d{4})",
      "flags": "i"
    },
    "age": {
      "exclusions": ["%", "percent", "grade", "average", "gpa", "score"],
      "pattern": "(?:(?:not\\s*more\\s*than|no\\s*more\\s*than|no\\s*older\\s*than|maximum\\s*of|under|below|must\\s*be\\s*at\\s*most)\\s*(\\d{1,2})\\s*(?:years?\\s*(?:old|of\\s*age)?|y\\/?o)|\\b(\\d{1,2})\\s*years?\\s*old\\s*or\\s*younger|\\bage\\s*(?:limit\\s*of|of|must\\s*be\\s*(?:under|below|at\\s*most))?\\s*(\\d{1,2})\\b)",
      "flags": "i"
    },
    "income": {
      "keywords": ["income", "gross", "salary", "financial capacity", "earnings", "financial eligibility"],
      "pattern": "(?:₱|PHP|Php|P|USD|US\\$|\\$)\\s*([\\d,]+(?:\\.\\d+)?)",
      "flags": "i",
      "scope_mapping": {
        "parents": ["parent", "father", "mother"],
        "family": ["family", "household"],
        "individual": ["individual", "personal"]
      },
      "period_mapping": {
